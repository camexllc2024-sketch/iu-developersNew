# Email Configuration for Nodemailer
# Copy this file to .env and fill in your actual email credentials

# SMTP Server Configuration (using IU Developers email server)
SMTP_HOST=mail.iudevelopers.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@iudevelopers.com
SMTP_PASS=your-email-password

# Note: Use the actual password for info@iudevelopers.com
# The server requires SSL/TLS on port 465

# Alternative SMTP Providers (if needed):
# Gmail: smtp.gmail.com:587
# Outlook: smtp-mail.outlook.com:587
# Yahoo: smtp.mail.yahoo.com:587
# SendGrid: smtp.sendgrid.net:587
